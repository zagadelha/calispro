rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // REGRAS DE PRODUÇÃO - CalisPro
    // Última atualização: 2026-02-06
    // ========================================
    
    // Users collection - usuário pode ler e escrever APENAS seus próprios dados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Plans collection - usuário só pode acessar seus próprios planos
    match /plans/{planId} {
      // Leitura: só se for dono do plano
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      // Criação: só pode criar para si mesmo
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      // Update/Delete: só se for dono
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    
    // Workouts collection - usuário só pode acessar seus próprios treinos
    match /workouts/{workoutId} {
      // Leitura: só se for dono do treino
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      // Criação: só pode criar para si mesmo
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      // Update/Delete: só se for dono
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    
    // Workout exercises - vinculado ao treino e usuário
    match /workout_exercises/{exerciseId} {
      // Leitura: só se for dono
      allow read: if request.auth != null && (
        resource.data.user_id == request.auth.uid || 
        // Fallback para legados (verificação de workout dono) - menos performático mas mantém compatibilidade
        get(/databases/$(database)/documents/workouts/$(resource.data.workout_id)).data.user_id == request.auth.uid
      );
      // Criação: permite se for o dono
      allow create: if request.auth != null && (
        request.resource.data.user_id == request.auth.uid ||
        // Fallback legado: se não enviar user_id, verifica o workout_id
        get(/databases/$(database)/documents/workouts/$(request.resource.data.workout_id)).data.user_id == request.auth.uid
      );
      // Update/Delete: só se for dono
      allow update, delete: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        get(/databases/$(database)/documents/workouts/$(resource.data.workout_id)).data.user_id == request.auth.uid
      );
    }

    // History collection - progressões e recordes do usuário
    match /history/{historyId} {
      // Leitura: só se for dono
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      // Criação: só pode criar para si mesmo
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      // Update/Delete: só se for dono
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    
    // Feedback collection - com validação básica anti-spam
    match /feedback/{feedbackId} {
      // Criação: permite qualquer um mas com validação de campos
      allow create: if request.resource.data.keys().hasAll(['feedback_type', 'message', 'created_at'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 5000;
      // Leitura/Atualização: apenas administradores
      allow read, update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
      // Deletar: nunca permitido
      allow delete: if false;
    }
  }
}
