		$(document).on('click', '.mobil_menu_open_bar', function(e){
			e.preventDefault();
			$('a.winner_responsive_menu_btn').click();
			return false;
		});
		
		
		
		$(document).on('click', '.mobil_bar ul li:nth-child(2) a', function(e){
			e.preventDefault();
			$('a.winner_responsive_menu_btn').click();
			$('.responsive > ul.menu > li:nth-child(3) .sub-menu').slideToggle();
			console.log(433);
			return false;
		});
		
		$(document).on('click', 'ul.my_programs_prog_list > li > a', function(e){
			e.preventDefault();
			
			//$('ul.my_programs_prog_list li').removeClass('acik');
			$(this).parent().toggleClass('acik');
			//$('.tek_prog_inner_wrap').hide();
			$(this).parent().find('.tek_prog_inner_wrap').slideToggle();
			return false;
		});
		
		function kaloriCalc(){
			var gender = $('[name="gender"]').val();
			var age = $('[name="age"]').val();
			var height = $('[name="length"]').val();
			var weight = $('[name="weight"]').val();
			age = parseInt(age);
			height = parseInt(height);
			weight = parseInt(weight);
			var goal = $('[name="goal"]').val();
			var activity = $('[name="activity"]').val();
			var result = 0;
			if( gender && weight && height && age && goal && activity){
				if( gender=='Female' ){
					result = ( (weight * 10) + (height * 6.25) - (age * 5) - 161 );
				}else{
					result = ( (weight * 10) + (height * 6.25) - (age * 5) + 5 );
				}
			}
			
			switch (activity) {
				case 'lightly-active':    result = Math.round(result * 1.1); break;
				case 'moderately-active': result = Math.round(result * 1.3); break;
				case 'very-active':       result = Math.round(result * 1.5); break;
				case 'extra-active':      result = Math.round(result * 1.7); break;
			}

			switch (goal) {
				case 'fat-loss':
					if ( result <= 2000 ) { result = result * 0.9; }
					if ( result > 2000 ) { result = result * 0.8; }
					break;
				case 'maintenance':
					break;
				case 'muscle-gain':
					result += 500;
					break;
			}
			$('#daily_calorie').val(parseInt(result));
		}
		$(document).on('change', '[name="gender"], [name="age"], [name="length"], [name="weight"], [name="goal"], [name="activity"]', function(e){
			e.preventDefault();
			kaloriCalc();
			return false;
		});
		
		var pr = '2';
